<Window x:Class="CipherVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CipherVault"
        xmlns:viewmodels="clr-namespace:CipherVault.ViewModels"
        mc:Ignorable="d"
        Title="CipherVault" Height="768" Width="1024"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Inter, Segoe UI, sans-serif">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0256FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="DestructiveBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9"/>

        <!-- Base Styles -->
        <Style TargetType="TextBlock" x:Key="BaseText">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}" x:Key="HeadingText">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}" x:Key="LabelText">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="IconText">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Monospace TextBox -->
        <Style TargetType="TextBox" x:Key="MonoInput">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10,40,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Menu Item -->
        <Style TargetType="RadioButton" x:Key="SidebarMenuBtn">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="BgBorder" CornerRadius="6" Background="Transparent" Margin="8,4"/>
                            <Border x:Name="ActiveIndicator" Width="4" HorizontalAlignment="Left" Background="Transparent" CornerRadius="0,4,4,0"/>
                            <StackPanel Orientation="Horizontal" Margin="24,12">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource IconText}" Margin="0,0,12,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="ActiveIndicator" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline Button -->
        <Style TargetType="Button" x:Key="OutlineBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action Button (Icon) -->
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" Padding="8" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="InputIconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" Padding="6" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Area -->
                <StackPanel Grid.Row="0" Margin="20,24,20,32">
                    <TextBlock Text="CipherVault" Style="{StaticResource HeadingText}"/>
                    <TextBlock Text="ENTERPRISE GRADE" Style="{StaticResource LabelText}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="Vault" Tag="&#xE8F1;" IsChecked="True" Style="{StaticResource SidebarMenuBtn}" GroupName="Nav"/>
                    <RadioButton Content="Favorites" Tag="&#xE734;" Style="{StaticResource SidebarMenuBtn}" GroupName="Nav"/>
                    <RadioButton Content="Security Audit" Tag="&#xEA18;" Style="{StaticResource SidebarMenuBtn}" GroupName="Nav"/>
                    <RadioButton Content="Settings" Tag="&#xE713;" Style="{StaticResource SidebarMenuBtn}" GroupName="Nav"/>
                </StackPanel>

                <!-- Bottom Sidebar -->
                <StackPanel Grid.Row="2" Margin="16,24">
                    <Button Content="+ Add New Item" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,24" Command="{Binding AddNewItemCommand}"/>

                    <!-- User Profile Footer -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#E2E8F0" Margin="0,0,12,0">
                            <TextBlock Text="AC" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Alex Chen" Style="{StaticResource BaseText}" FontWeight="SemiBold"/>
                            <TextBlock Text="Security Architect" Style="{StaticResource LabelText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource CardBrush}">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Global Search -->
                    <Border Background="#F1F5F9" CornerRadius="16" Height="32" Padding="12,0" HorizontalAlignment="Left" Width="300">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE11A;" Style="{StaticResource IconText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" FontSize="14"/>
                                <TextBlock Text="Search vault items..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text.Length}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="22,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Top Utilities -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionBtn}" Margin="0,0,4,0">
                            <TextBlock Text="&#xE117;" Style="{StaticResource IconText}"/>
                        </Button>
                        <Button Style="{StaticResource ActionBtn}" Margin="0,0,4,0">
                            <TextBlock Text="&#xE897;" Style="{StaticResource IconText}"/>
                        </Button>
                        <Button Style="{StaticResource ActionBtn}" Margin="0,0,0,0">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource IconText}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sub-Header Breadcrumb & Actions -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#F8FAFC">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Breadcrumb -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Vault" Style="{StaticResource LabelText}" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="&gt;" Style="{StaticResource LabelText}" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectedVaultItem.Title}" Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text=" - " Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding SelectedVaultItem.Category}" Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Edit" Style="{StaticResource OutlineBtn}" Margin="0,0,12,0" Command="{Binding EditItemCommand}"/>
                        <Button Content="Delete" Style="{StaticResource OutlineBtn}" Foreground="{StaticResource DestructiveBrush}" BorderBrush="{StaticResource DestructiveBrush}" Command="{Binding DeleteItemCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Vault Entry Detail Workspace (Two Columns) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Vault Details -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <!-- Header Block -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" CornerRadius="12" Background="#F1F5F9" Margin="0,0,16,0">
                                    <TextBlock Text="&#xE14B;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="32" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedVaultItem.Title}" Style="{StaticResource HeadingText}" FontSize="20" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedVaultItem.Subtitle}" Style="{StaticResource BaseText}" Foreground="{StaticResource TextMutedBrush}"/>

                                    <!-- Badges -->
                                    <ItemsControl ItemsSource="{Binding SelectedVaultItem.Badges}" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9" CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource LabelText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Form Fields -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel>
                                <!-- Username Field -->
                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="USERNAME / EMAIL" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <TextBox Text="{Binding SelectedVaultItem.Username}" IsReadOnly="True" Style="{StaticResource MonoInput}"/>
                                        <Button Style="{StaticResource InputIconBtn}" HorizontalAlignment="Right" Margin="4" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedVaultItem.Username}" ToolTip="Copy Username">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Password Field -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="PASSWORD" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <TextBox IsReadOnly="True" Padding="12,10,70,10">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource MonoInput}">
                                                    <Setter Property="Text" Value="••••••••••••••••••••"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                            <Setter Property="Text" Value="{Binding SelectedVaultItem.EncryptedPassword}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
                                            <Button Style="{StaticResource InputIconBtn}" Command="{Binding TogglePasswordVisibilityCommand}" ToolTip="Toggle Visibility">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                                            <Setter Property="Text" Value="&#xE890;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE18B;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Style="{StaticResource InputIconBtn}" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedVaultItem.EncryptedPassword}" ToolTip="Copy Password">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Password Strength -->
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}"/>
                                        <Border Grid.Column="2" Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}"/>
                                        <Border Grid.Column="4" Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}"/>
                                        <Border Grid.Column="6" Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}"/>
                                        <Border Grid.Column="8" Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="EXCELLENT (98/100)" Style="{StaticResource LabelText}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>

                                <!-- Website URL Field -->
                                <StackPanel Margin="0,0,0,32">
                                    <TextBlock Text="WEBSITE URL" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <TextBox Text="{Binding SelectedVaultItem.Url}" IsReadOnly="True" Style="{StaticResource MonoInput}"/>
                                        <Button Style="{StaticResource InputIconBtn}" HorizontalAlignment="Right" Margin="4" Command="{Binding LaunchExternalUrlCommand}" CommandParameter="{Binding SelectedVaultItem.Url}" ToolTip="Open in Browser">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Notes Block -->
                                <StackPanel>
                                    <TextBlock Text="SECURE NOTES" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="16" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                        <TextBlock Text="{Binding SelectedVaultItem.Notes}" Style="{StaticResource BaseText}" TextWrapping="Wrap" LineHeight="20"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Security Insights & History -->
                    <StackPanel Grid.Column="1">
                        <!-- Security Insights -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="SECURITY INSIGHTS" Style="{StaticResource LabelText}" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="6" Background="#F1F5F9" Margin="0,0,12,0">
                                        <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="MFA Enabled" Style="{StaticResource BaseText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedVaultItem.MfaStatus}" Style="{StaticResource LabelText}" FontWeight="Normal" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="6" Background="#F1F5F9" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE787;" Style="{StaticResource IconText}" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Last Rotated" Style="{StaticResource BaseText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="12 days ago" Style="{StaticResource LabelText}" FontWeight="Normal" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="6" Background="#F1F5F9" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Breach Status" Style="{StaticResource BaseText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedVaultItem.BreachStatus}" Style="{StaticResource LabelText}" FontWeight="Normal" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Security History -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="SECURITY HISTORY" Style="{StaticResource LabelText}" Margin="0,0,0,20"/>

                                <Grid>
                                    <!-- Vertical Timeline Line -->
                                    <Border Width="2" Background="#E2E8F0" HorizontalAlignment="Left" Margin="15,0,0,0" CornerRadius="1"/>

                                    <ItemsControl ItemsSource="{Binding SelectedVaultItem.AuditLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Icon Badge -->
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#EFF6FF" BorderBrush="{StaticResource CardBrush}" BorderThickness="2" Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <TextBlock Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                                                    <Setter Property="Text" Value="&#xE9CE;"/> <!-- Default icon -->
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IconType}" Value="Pencil">
                                                                            <Setter Property="Text" Value="&#xE70F;"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IconType}" Value="Eye">
                                                                            <Setter Property="Text" Value="&#xE890;"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IconType}" Value="Copy">
                                                                            <Setter Property="Text" Value="&#xE8C8;"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IconType}" Value="Plus">
                                                                            <Setter Property="Text" Value="&#xE710;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ActionType}" Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Timestamp, StringFormat='MMM dd, yyyy - HH:mm'}" Style="{StaticResource LabelText}" FontWeight="Normal" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <TextBlock Text="View full audit trail" Foreground="{StaticResource PrimaryBrush}" Style="{StaticResource BaseText}" FontWeight="Medium" FontSize="13" Margin="0,8,0,0" Cursor="Hand" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
